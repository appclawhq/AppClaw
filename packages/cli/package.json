{
  "name": "@appclaw/cli",
  "version": "2.4.1",
  "description": "AppClaw interactive CLI (Ink) for mobile automation",
  "type": "module",
  "bin": {
    "appclaw": "bin/appclaw.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@appclaw/core": "2.4.1",
    "@appclaw/runner": "2.4.1",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "wrap-ansi": "^9.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
