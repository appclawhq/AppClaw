{
  "name": "appclaw",
  "version": "2.0.2",
  "description": "Agentic AI layer for mobile automation via appium-mcp",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/runner"
  ],
  "scripts": {
    "build": "npm run build -w @appclaw/core && npm run build -w @appclaw/cli && npm run build -w @appclaw/runner && npm run build -w @appclaw/agent",
    "typecheck": "npm run build -w @appclaw/core && npm run typecheck -w @appclaw/cli && npm run typecheck -w @appclaw/runner && npm run typecheck -w @appclaw/agent",
    "lint": "npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "npx tsx scripts/generate-preview.ts preview",
    "pretest": "npm run build",
    "test": "vitest run tests/flow tests/sdk tests/ui",
    "test:e2e": "vitest run tests/e2e/",
    "test:e2e:android": "MCP_DEBUG=1 vitest run tests/vodqa.test.ts",
    "test:watch": "vitest tests/flow tests/sdk tests/ui",
    "build:vsix": "cd vscode-extension && npm run build && npx vsce package",
    "deploy:landing": "npm run deploy --prefix landing"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/bun": "^1.1.0",
    "@types/gradient-string": "^1.1.6",
    "@types/react": "^18.3.31",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "3.8.3",
    "semantic-release": "^24.2.9",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "jose": "^6.1.3"
  }
}
