---
// Shared chrome for the blog listing + posts. Matches the "Precision /
// Technical" identity of index.astro (Menlo mono, teal accent, hairline
// borders, light default with a dark toggle). Design tokens live in
// src/styles/site.css so this stays a thin wrapper.
import "../styles/site.css";

const GH = "https://github.com/AppiumTestDistribution/appclaw";

interface Props {
  title: string;
  description: string;
  /** accent palette class applied to <body>: acc-emerald | acc-amber | acc-indigo */
  accent?: string;
}

const {
  title,
  description,
  accent = "acc-emerald",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply theme before first paint. Default: light. Stored choice wins.
      (function () {
        try {
          if (localStorage.getItem("theme") === "dark") {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=JetBrains+Mono:ital,wght@0,400..700;1,400..600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class={accent}>
    <nav id="nav">
      <div class="wrap nav-bar">
        <a class="brand" href="/"><img src="/logo.svg" alt="" />AppClaw</a>
        <div class="nav-links">
          <a href="/#agentic">Agentic goal</a>
          <a href="/#context">Memory</a>
          <a href="/#locate">Locators</a>
          <a href="/blog" class="active">Blog</a>
        </div>
        <div class="nav-cta">
          <button class="theme-sw" id="themeToggle" type="button" role="switch" aria-label="Toggle dark mode" title="Toggle light / dark">
            <svg class="ico edge sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="ico edge moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <span class="knob">
              <svg class="ico s-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
              <svg class="ico s-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            </span>
          </button>
          <a class="btn alt sm gh" href={GH} target="_blank" rel="noopener">Star on GitHub</a>
          <a class="btn sm" href="/usage.html">Get Started</a>
        </div>
      </div>
    </nav>

    <div class="wrap">
      <slot />

      <footer>
        <div class="foot-grid">
          <div class="foot-brand">
            <a class="brand" href="/"><img src="/logo.svg" alt="" />AppClaw</a>
            <p>The mobile automation agent. Tell it what you want in plain English, it resolves the rest.</p>
          </div>
          <div><h6>Product</h6><ul><li><a href="/#agentic">Agentic goal</a></li><li><a href="/#context">Memory &amp; guides</a></li><li><a href="/#modes">Modes</a></li><li><a href="/#locate">Locators</a></li></ul></div>
          <div><h6>Developers</h6><ul><li><a href={`${GH}#quick-start`} target="_blank" rel="noopener">Quick Start</a></li><li><a href="https://www.npmjs.com/package/appclaw" target="_blank" rel="noopener">CLI (npm)</a></li><li><a href="/usage.html">Usage Guide</a></li><li><a href="/blog">Blog</a></li></ul></div>
          <div><h6>Community</h6><ul><li><a href={`${GH}/issues`} target="_blank" rel="noopener">Issues</a></li><li><a href={`${GH}/discussions`} target="_blank" rel="noopener">Discussions</a></li><li><a href={`${GH}/blob/main/LICENSE`} target="_blank" rel="noopener">License</a></li></ul></div>
        </div>
        <div class="foot-bottom">
          <span>© 2026 AppClaw. Open source under Apache 2.0.</span>
          <a href={GH} target="_blank" rel="noopener" style="color:var(--ink-soft)">GitHub ↗</a>
        </div>
      </footer>
    </div>

    <script is:inline>
      const nav = document.getElementById("nav");
      if (nav) { const f = () => nav.classList.toggle("scrolled", window.scrollY > 8); window.addEventListener("scroll", f, { passive: true }); f(); }

      const root = document.documentElement;
      const tg = document.getElementById("themeToggle");
      const sync = () => { if (tg) tg.setAttribute("aria-checked", root.classList.contains("dark") ? "true" : "false"); };
      sync();
      if (tg) tg.addEventListener("click", () => {
        root.classList.add("theme-anim");
        const dark = root.classList.toggle("dark");
        try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (e) {}
        sync();
        window.setTimeout(() => root.classList.remove("theme-anim"), 280);
      });

      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); obs.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll(".rv:not(.in)").forEach((el) => obs.observe(el));
    </script>
  </body>
</html>
