{
  "name": "appclaw-runner-example",
  "private": true,
  "type": "module",
  "comment": "This example's .env lives at the repo root, so scripts pass --env-file. In your own project, put .env next to package.json and it's auto-loaded — drop the flag.",
  "scripts": {
    "test": "appclaw-runner --env-file ../../.env",
    "test:parallel": "appclaw-runner --env-file ../../.env --workers 3",
    "test:login": "appclaw-runner --env-file ../../.env tests/login.spec.ts",
    "test:grep": "appclaw-runner --env-file ../../.env --grep login",
    "test:ci": "appclaw-runner --env-file ../../.env --workers 2 --retries 1 --shard 1/1"
  },
  "devDependencies": {
    "@appclaw/core": "2.4.1",
    "@appclaw/runner": "2.4.1",
    "tsx": "^4.21.0"
  },
  "version": "2.4.1"
}
